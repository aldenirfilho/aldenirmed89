{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "antigravity-nexus-private-intake-v2",
  "title": "Recibo privado de intake NEXUS",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "queueStatus",
    "receiptFile",
    "idempotencyKey",
    "artifactUid",
    "intentUid",
    "createdAt",
    "updatedAt",
    "date",
    "sequence",
    "entityCode",
    "productCode",
    "productUid",
    "semanticKey",
    "procedureCode",
    "sessionCode",
    "title",
    "objective",
    "kind",
    "block",
    "universe",
    "privacy",
    "structuralTags",
    "source",
    "route",
    "surfaces",
    "attestations",
    "events",
    "publication"
  ],
  "properties": {
    "schemaVersion": {"const": "antigravity-nexus-private-intake-v2"},
    "revision": {"type": "integer", "minimum": 1},
    "queueStatus": {"type": "string"},
    "receiptFile": {"type": "string", "pattern": "^[a-f0-9]{64}\\.json$"},
    "idempotencyKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactUid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "intentUid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9999},
    "entityCode": {"type": "string", "pattern": "^####(DOC|PDF|IMG)-[0-9]{8}-[0-9]{4}-[A-F0-9]{8}$"},
    "productCode": {"type": "string", "pattern": "^####AGX-(U1|U2|U3|MUX)-(EVO|PLAN|VIS|STUDY|TEMI|REFINE|TUTOR|EXT)-[0-9]{8}-[0-9]{4}-[A-F0-9]{8}$"},
    "productUid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticKey": {"type": "string", "minLength": 1},
    "procedureCode": {"type": "string", "pattern": "^PRC###-ACOPLAR-[0-9]{8}-[0-9]{4}-[A-F0-9]{8}$"},
    "sessionCode": {"type": "string", "pattern": "^####SES-[0-9]{8}-[0-9]{4}-[A-F0-9]{8}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective": {"type": "string", "minLength": 1, "maxLength": 240},
    "kind": {"enum": ["gpt-word", "gpt-pdf", "gpt-image"]},
    "block": {"enum": ["EVO", "PLAN", "VIS", "STUDY", "TEMI", "REFINE", "TUTOR", "EXT"]},
    "universe": {"enum": ["U1", "U2", "U3", "MUX"]},
    "privacy": {"enum": ["P0", "P1", "P2", "P3"]},
    "structuralTags": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "required": ["blobPath", "sha256", "sizeBytes", "mime", "originalNameHash"]
    },
    "route": {"type": "object"},
    "surfaces": {
      "type": "object",
      "required": ["drive", "notion", "githubDraft", "library", "officialSite"]
    },
    "attestations": {"type": "object"},
    "events": {"type": "array", "minItems": 1},
    "publication": {"type": "object"}
  }
}
