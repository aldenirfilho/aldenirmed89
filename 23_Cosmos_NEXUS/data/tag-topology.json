{
  "schemaVersion": "antigravity-tag-topology-v1",
  "version": "1.1.0",
  "updatedAt": "2026-08-01",
  "purpose": "Topografar cada produto no universo-grafo antes da acoplagem ao Mapa Vivo.",
  "grammar": {
    "structuralTagPattern": "^###(DOMINIO|UNIVERSO|CONSTELACAO|BLOCO|STATUS|PRIVACIDADE|MATURIDADE):[A-Z0-9_-]+$",
    "topicTagPattern": "^#[A-Za-zÀ-ÿ0-9_-]+$",
    "requiredStructuralNamespaces": ["UNIVERSO", "CONSTELACAO", "BLOCO", "STATUS", "PRIVACIDADE"],
    "rule": "###TAG localiza estruturalmente; #TAG nomeia o conteúdo clínico/didático."
  },
  "examples": [
    "###UNIVERSO:U1",
    "###CONSTELACAO:EVOLUCOES",
    "###BLOCO:EVOLUCAO",
    "###STATUS:EM_REVISAO",
    "###PRIVACIDADE:P0",
    "#Choque",
    "#Reavaliacao"
  ],
  "universes": {
    "U1": ["EVOLUCOES", "TEMAS", "IMAGENS", "ARSENAL"],
    "U2": ["TEMAS", "IMAGENS", "ACRA", "APOSTILAS", "ARSENAL", "QUESTOES"],
    "U3": ["TEMAS", "IMAGENS", "ACRA", "APOSTILAS", "QUESTOES"]
  },
  "blockTags": ["EVOLUCAO", "PLANO_TERAPEUTICO", "MOTOR_VISUAL", "ORGANIZADOR_ESTUDOS", "TURBO_TEMI", "REFINARIA_TEMI", "TUTOR", "ESTUDO_MICROPARTICULADO", "IMAGENS_TURBO_TEMI", "PRODUTOS_TURBO_TEMI", "REFERENCIAS_EVIDENCIAS", "AUDITORIA_PUBLICACAO", "EXTENSAO"],
  "statuses": ["RASCUNHO", "EM_REVISAO", "APROVADO_LOCAL", "CANDIDATO_PUBLICO", "PUBLICADO", "BLOQUEADO"],
  "privacyClasses": ["P0", "P1", "P2", "P3"],
  "maturity": ["CANDIDATA", "ATIVA", "MADURA", "DEPRECADA", "REJEITADA"],
  "relations": ["ACIONA", "AGENDA", "ALIMENTA", "ANCORA", "APROFUNDA", "AUDITA", "BLOQUEIA", "COMPRIME", "CONTEXTUALIZA", "DERIVA", "DOCUMENTA", "EMPACOTA", "ENSINA", "EVIDENCIA", "EXTRAI", "FUNDE_EM", "MICROPARTICULA", "ORQUESTRA", "REAVALIA", "REFERENCIA", "REFINA", "RENDERIZA", "REPRESENTA", "RETORNA_AO_CASO", "SUBSTITUI", "SUSTENTA", "TESTA", "TOPOGRAFA", "TREINA", "TUTORIA"],
  "edgeContract": {
    "required": ["from", "relation", "to", "evidenceIds", "reviewStatus"],
    "key": "SHA256(from|relation|to|qualifier)",
    "noImplicitExpansion": "Uma TAG composta é um conceito próprio; nunca expandir silenciosamente."
  },
  "constraints": [
    "Todo item pertence a pelo menos um universo e uma constelação.",
    "Todo endpoint de aresta precisa existir antes da fusão.",
    "P1–P3 nunca são enviados a GitHub, Sites ou árvore pública.",
    "Ausência de fonte, revisão ou direitos bloqueia publicação.",
    "Arestas novas entram como propostas até revisão humana."
  ]
}
