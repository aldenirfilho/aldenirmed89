    },
    {
      "id":"graph","label":"Subgrafo fusional","icon":"🕸️","preserves":["interconexão","proveniência","universo","reuso"],
      "component":"focused-neighborhood","requiredFields":["nodes","edges","structuralTags"],"fallback":"lista de arestas"
    }
  ],
  "qualityContract": {
    "required":["QR0 Fidelidade","QR1 Tempo","QR2 Incerteza","QR3 Hierarquia","QR4 Compreensão","QR5 Execução","QR6 Carga cognitiva","QR7 Acessibilidade","QR8 Transferência"],
