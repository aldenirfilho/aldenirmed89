    },
    {
      "id":"timeline","label":"Timeline de evolução","icon":"📈","preserves":["sequência","tempo","delta","tendência"],
      "component":"proportional-timeline","requiredFields":["timestamp","event","certainty","sourceId"],"fallback":"tabela cronológica"
    },
    {
      "id":"matrix","label":"Tabela comparativa","icon":"▦","preserves":["comparação","critério","diferença","limite"],
      "component":"semantic-table","requiredFields":["columns","rows","caption"],"fallback":"lista por critério"
    },
    {
      "id":"chart","label":"Gráfico de tendência","icon":"▥","preserves":["magnitude","tendência","cobertura","variação"],
      "component":"accessible-bars","requiredFields":["title","points","unit","sourceId"],"fallback":"tabela de valores"
    },
    {
      "id":"visual","label":"Motor visual","icon":"🖼️","preserves":["localização","mecanismo","padrão","âncora"],
      "component":"image-with-contract","requiredFields":["src","alt","legend","limitations","sourceId","rights"],"fallback":"descrição textual integral"
    },
    {
      "id":"acra","label":"ACRA renderizado","icon":"🧬","preserves":["tentativa","feedback","correção","retomada"],
      "component":"active-recall","requiredFields":["prompt","answer","trap","transfer","reviewSchedule"],"fallback":"pergunta e resposta em texto"
