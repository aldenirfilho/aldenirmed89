{
  "schemaVersion": "antigravity-cosmos-render-recipes-v1",
  "version": "1.0.0",
  "updatedAt": "2026-07-31",
  "selectionRule": "A relação que precisa ser preservada escolhe a representação; preferência estética nunca substitui fidelidade.",
  "recipes": [
