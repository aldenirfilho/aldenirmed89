{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aldenirmed.chatgpt.site/schemas/nexus/render-22x/2.2.0",
  "title": "NEXUS Clinical Render 22X",
  "type": "object",
  "required": ["case_ir_id", "render_id", "levels", "points", "render9", "tag_depot"],
  "properties": {
    "case_ir_id": {"type": "string"},
    "render_id": {"type": "string"},
    "levels": {
      "type": "object",
      "required": ["agora", "decisao", "analise_22x", "aprendizagem", "tag_depot"],
      "properties": {
        "agora": {"type": "object"},
        "decisao": {"type": "object"},
        "analise_22x": {"type": "object"},
        "aprendizagem": {"type": "object"},
        "tag_depot": {"type": "object"}
      }
    },
    "points": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "required": ["number", "title", "status", "evidence_ids"],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 22},
          "title": {"type": "string"},
          "status": {"enum": ["complete", "partial", "missing", "not_applicable"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "component": {
            "enum": ["text", "timeline", "trend", "matrix", "diagram", "algorithm", "checklist", "alert", "graph"]
          }
        },
        "additionalProperties": true
      }
    },
    "render9": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["gate", "status"],
        "properties": {
          "gate": {"type": "string"},
          "status": {"enum": ["pass", "fail", "blocked", "needs_review"]},
          "note": {"type": "string"}
        }
      }
    },
    "tag_depot": {
      "type": "object",
      "required": ["nuclear", "top5", "clusters", "edges"],
      "properties": {
        "nuclear": {"type": "string"},
        "top5": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
        "clusters": {"type": "object"},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "relation", "to", "evidence_ids"],
            "properties": {
              "from": {"type": "string"},
              "relation": {"type": "string"},
              "to": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}

