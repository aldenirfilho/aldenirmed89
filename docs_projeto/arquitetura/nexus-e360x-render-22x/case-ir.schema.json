{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aldenirmed.chatgpt.site/schemas/nexus/case-ir/2.0.0",
  "title": "NEXUS E360X CASE-IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_ir_id",
    "revision",
    "privacy",
    "temporal_cut",
    "sources",
    "facts",
    "problems",
    "uncertainties",
    "tags",
    "provenance"
  ],
  "properties": {
    "case_ir_id": {"type": "string", "minLength": 12},
    "revision": {"type": "integer", "minimum": 1},
    "privacy": {
      "type": "object",
      "required": ["class", "deidentified", "publication_scope"],
      "properties": {
        "class": {"enum": ["P0", "P1", "P2", "P3"]},
        "deidentified": {"type": "boolean"},
        "publication_scope": {"enum": ["private", "restricted", "public_safe"]}
      },
      "additionalProperties": false
    },
    "temporal_cut": {
      "type": "object",
      "required": ["as_of", "timezone"],
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "kind", "captured_at", "sha256"],
        "properties": {
          "source_id": {"type": "string"},
          "kind": {"type": "string"},
          "captured_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/atomicDatum"}
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["problem_id", "priority", "statement", "evidence_ids", "status"],
        "properties": {
          "problem_id": {"type": "string", "pattern": "^P[0-9]+$"},
          "priority": {"type": "integer", "minimum": 0},
          "statement": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["active", "improving", "worsening", "resolved", "uncertain"]}
        },
        "additionalProperties": true
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "#/$defs/atomicDatum"}
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "category", "evidence_ids"],
        "properties": {
          "tag": {"type": "string", "pattern": "^#[A-Za-z0-9_]+$"},
          "category": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["decoder", "decoder_version", "created_at"],
      "properties": {
        "decoder": {"const": "NEXUS_ARACNE_DECODE_E360X"},
        "decoder_version": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "atomicDatum": {
      "type": "object",
      "required": ["id", "value", "certainty", "source_ids"],
      "properties": {
        "id": {"type": "string"},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "certainty": {"enum": ["confirmed", "inferred", "divergent", "inherited", "absent"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}

