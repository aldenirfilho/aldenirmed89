+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+scan_content_module.py — Reindexador de um hub de conteúdo
+==========================================================
+Varre `inbox/` (e `acervo/`, se existir) de um módulo-hub e reconstrói
+`data/catalogo.json` no formato que `assets/js/content-hub.js` consome.
+Também conta os links de `links/links.json`.
+
+Uso:
+    python3 ../scripts_admin/scan_content_module.py [DIR_DO_MODULO]
+    (padrão: diretório atual)
+
+Saída: data/catalogo.json com paths VALIDADOS (só entram arquivos que existem).
+Idempotente: pode rodar quantas vezes quiser. É o motor da alimentação contínua.
+"""
+import os, sys, json, datetime, re
+
+# Grupos de formato (espelham GROUPS em content-hub.js)
+FORMAT_GROUPS = [
+    ("pdf",    "📄", "PDF",          ["pdf"]),
+    ("word",   "📝", "Word/DOCX",    ["doc", "docx"]),
+    ("sheet",  "📊", "Planilha/CSV", ["xls", "xlsx", "xlsm", "csv", "tsv"]),
+    ("md",     "⬇️", "Markdown",     ["md", "markdown"]),
+    ("slides", "📽️", "Slides",       ["ppt", "pptx"]),
+    ("anki",   "🃏", "Anki",         ["apkg"]),
+    ("html",   "🌐", "HTML",         ["html", "htm"]),
+    ("image",  "🖼️", "Imagem",       ["png", "jpg", "jpeg", "gif", "webp", "svg"]),
+    ("text",   "📃", "Texto/TXT",    ["txt", "rtf", "log"]),
+]
+EXT_TO_GROUP = {e: gid for gid, _emo, _lbl, exts in FORMAT_GROUPS for e in exts}
+GROUP_META = {gid: (emo, lbl) for gid, emo, lbl, _ in FORMAT_GROUPS}
+
+IGNORE = {".DS_Store", "Thumbs.db", ".gitkeep", "_last_sync.txt"}
+
+
+def ext_of(name):
+    m = re.search(r"\.([A-Za-z0-9]+)$", name)
+    return m.group(1).lower() if m else ""
+
+
+def group_of(ext):
+    return EXT_TO_GROUP.get(ext, "text")
+
+
+def clean_title(filename):
+    base = re.sub(r"\.[^.]+$", "", filename)
+    base = re.sub(r"[_]+", " ", base).strip()
+    return base
+
+
+def scan_dir(module_dir, sub):
+    """Retorna lista de itens para uma subpasta (inbox/acervo)."""
+    items = []
+    root = os.path.join(module_dir, sub)
+    if not os.path.isdir(root):
+        return items
+    for dp, dn, fn in os.walk(root):
+        dn[:] = [d for d in dn if not d.startswith(".")]
+        for f in sorted(fn):
+            if f in IGNORE or f.startswith("."):
+                continue
+            abs_p = os.path.join(dp, f)
+            rel_p = os.path.relpath(abs_p, module_dir).replace(os.sep, "/")
+            ext = ext_of(f)
+            grp = group_of(ext)
+            emo, lbl = GROUP_META.get(grp, ("📦", "Outro"))
+            items.append({
+                "id": re.sub(r"[^a-z0-9]+", "-", rel_p.lower()).strip("-"),
+                "title": clean_title(f),
+                "path": rel_p,
+                "ext": ext,
+                "format": grp,
+                "formatLabel": lbl,
+                "formatEmoji": emo,
+                "source": "inbox" if sub == "inbox" else "acervo",
+                "status": "revisar" if sub == "inbox" else "catalogado",
+                "tags": [],
+                "summary": "",
+            })
+    return items
+
+
+def load_existing_metadata(catalogo_path):
+    """Preserva título/resumo/tags já curados (casados por path)."""
+    meta = {}
+    if os.path.isfile(catalogo_path):
+        try:
+            old = json.load(open(catalogo_path, encoding="utf-8"))
+            for it in old.get("items", []):
+                if it.get("path"):
+                    meta[it["path"]] = {
+                        "title": it.get("title"),
+                        "summary": it.get("summary") or it.get("resumo"),
+                        "tags": it.get("tags") or [],
+                        "status": it.get("status"),
+                    }
+        except Exception:
+            pass
+    return meta
+
+
+def main(module_dir):
+    module_dir = os.path.abspath(module_dir)
+    data_dir = os.path.join(module_dir, "data")
+    os.makedirs(data_dir, exist_ok=True)
+    catalogo_path = os.path.join(data_dir, "catalogo.json")
+
+    # bloco "module" (de module.json ou catalogo antigo)
+    module_block = {"id": os.path.basename(module_dir), "title": os.path.basename(module_dir)}
+    mj = os.path.join(module_dir, "module.json")
+    if os.path.isfile(mj):
+        try:
+            module_block = json.load(open(mj, encoding="utf-8"))
+        except Exception:
+            pass
+    elif os.path.isfile(catalogo_path):
+        try:
+            module_block = json.load(open(catalogo_path, encoding="utf-8")).get("module", module_block)
+        except Exception:
+            pass
+
+    prev_meta = load_existing_metadata(catalogo_path)
+
+    items = scan_dir(module_dir, "inbox") + scan_dir(module_dir, "acervo")
+    # validação de path + reaplicação de metadados curados
+    valid = []
+    for it in items:
+        if not os.path.isfile(os.path.join(module_dir, it["path"])):
+            continue
+        m = prev_meta.get(it["path"])
+        if m:
+            if m.get("title"):   it["title"] = m["title"]
+            if m.get("summary"): it["summary"] = m["summary"]
+            if m.get("tags"):    it["tags"] = m["tags"]
+            if m.get("status"):  it["status"] = m["status"]
+        valid.append(it)
+
+    # links
+    links = []
+    lp = os.path.join(module_dir, "links", "links.json")
+    if os.path.isfile(lp):
+        try:
+            ld = json.load(open(lp, encoding="utf-8"))
+            links = ld if isinstance(ld, list) else ld.get("links", ld.get("items", []))
+        except Exception:
+            links = []
+
+    # contagem por formato
+    counts = {}
+    for it in valid:
+        counts[it["format"]] = counts.get(it["format"], 0) + 1
+    formats = [{"id": g, "emoji": GROUP_META[g][0], "label": GROUP_META[g][1], "count": counts[g]}
+               for g in counts]
+
+    catalogo = {
+        "updatedAt": datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S"),
+        "module": module_block,
+        "totalItems": len(valid) + len(links),
+        "totalFiles": len(valid),
+        "totalLinks": len(links),
+        "formats": formats,
+        "items": valid,
+    }
+    json.dump(catalogo, open(catalogo_path, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
+    print(f"[scan_content_module] {module_block.get('title', module_dir)}")
+    print(f"  arquivos: {len(valid)} | links: {len(links)} | formatos: {len(formats)}")
+    print(f"  -> {os.path.relpath(catalogo_path)}")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1] if len(sys.argv) > 1 else ".")
