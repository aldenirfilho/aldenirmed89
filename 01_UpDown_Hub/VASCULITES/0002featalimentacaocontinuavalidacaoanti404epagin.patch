+#!/bin/bash
+# =====================================================================
+#  atualizar_tudo.sh — ALIMENTAÇÃO CONTÍNUA (um comando só)
+#  ---------------------------------------------------------------------
+#  Reindexa TODO o conteúdo do site a partir das pastas de entrada e
+#  valida que nenhum documento aponta para um caminho quebrado (404).
+#
+#  Fluxo do dia a dia:
+#    1) Solte arquivos nas pastas de entrada (veja PLANO_ALIMENTACAO_CONTINUA.md)
+#    2) Rode:  bash scripts_admin/atualizar_tudo.sh
+#    3) git add -A && git commit -m "conteudo: atualiza acervo" && git push
+# =====================================================================
+set -e
+cd "$(dirname "$0")/.."   # raiz do repositório
+ROOT="$(pwd)"
+echo "📂 Raiz: $ROOT"
+echo ""
+
+echo "── 1/3 · Hubs de conteúdo (inbox -> data/catalogo.json) ────────────"
+for h in 04_Ebooks_Intensiva_Clinica 07_Questoes_Comentadas 08_Transcricoes 09_POCUS_Hub; do
+  if [ -d "$h" ]; then
+    python3 scripts_admin/scan_content_module.py "$h"
+  fi
+done
+echo ""
+
+echo "── 2/3 · Biblioteca IA (acervo + inbox -> manifestos) ──────────────"
+if [ -f "02_Biblioteca_IA_Engine/scan_biblioteca.py" ]; then
+  ( cd 02_Biblioteca_IA_Engine && python3 scan_biblioteca.py ) || echo "  (scan_biblioteca.py indisponível — seguindo)"
+else
+  echo "  (sem scan_biblioteca.py — pulado)"
+fi
+echo ""
+
+echo "── 3/3 · Validação anti-404 (rede de segurança) ───────────────────"
+python3 scripts_admin/validar_paths.py
+echo ""
+
+echo "✅ Concluído. Próximo passo:"
+echo "   git add -A && git commit -m 'conteudo: atualiza acervo e manifestos' && git push origin <branch>"
+echo "   (Depois abra diagnostico.html para conferir o verde.)"
