+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+validar_paths.py — Rede de segurança anti-404 dos manifestos
+============================================================
+Percorre TODOS os manifestos do site e garante que cada `path` aponta para um
+arquivo que existe no disco. Quando o caminho diverge só por acento, espaço,
+underscore, ':' ou normalização Unicode (NFC/NFD), o caminho é CORRIGIDO para o
+nome real. Só remove a entrada se não houver arquivo correspondente.
+
+É idempotente e seguro: rode sempre após adicionar conteúdo / rodar os scanners.
+
+Uso:
+    python3 scripts_admin/validar_paths.py            # valida e corrige
+    python3 scripts_admin/validar_paths.py --check    # só relata (não grava)
+"""
+import os, sys, json, re, unicodedata, datetime
+from collections import defaultdict
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+# (arquivo_json, chave_da_lista, base_relativa_dos_paths)
+TARGETS = [
+    ("02_Biblioteca_IA_Engine/data/biblioteca_documentos_manifest.json", "files", "02_Biblioteca_IA_Engine"),
+    ("02_Biblioteca_IA_Engine/data/biblioteca_catalogo.json",            "items", "02_Biblioteca_IA_Engine"),
+    ("02_Biblioteca_IA_Engine/data/biblioteca_inbox_manifest_auto.json", "files", "02_Biblioteca_IA_Engine"),
+    ("04_Ebooks_Intensiva_Clinica/data/catalogo.json", "items", "04_Ebooks_Intensiva_Clinica"),
+    ("07_Questoes_Comentadas/data/catalogo.json",      "items", "07_Questoes_Comentadas"),
+    ("08_Transcricoes/data/catalogo.json",             "items", "08_Transcricoes"),
+    ("09_POCUS_Hub/data/catalogo.json",                "items", "09_POCUS_Hub"),
+]
+
+def norm_key(s):
+    s = unicodedata.normalize("NFC", s).lower()
+    s = re.sub(r"[ _\-]+", " ", s).strip()
+    return s
+
+def build_disk_index(base_abs):
+    """dir_abs -> { norm_basename -> rel_path_from_base }"""
+    idx = defaultdict(dict)
+    realset = set()
+    for dp, dn, fn in os.walk(base_abs):
+        dn[:] = [d for d in dn if not d.startswith(".")]
+        for f in fn:
+            absf = os.path.join(dp, f)
+            rel = os.path.relpath(absf, base_abs).replace(os.sep, "/")
+            realset.add(rel)
+            idx[os.path.normpath(dp)][norm_key(f)] = rel
+    return idx, realset
+
+def resolve(path, base_abs, idx, realset):
+    if not path:
+        return None
+    if path in realset and os.path.isfile(os.path.join(base_abs, path)):
+        return path
+    # tentativa direta
+    if os.path.isfile(os.path.join(base_abs, path)):
+        return path
+    # ':' -> '-'
+    if ":" in path:
+        r = resolve(path.replace(":", "-"), base_abs, idx, realset)
+        if r:
+            return r
+    d = os.path.normpath(os.path.join(base_abs, os.path.dirname(path)))
+    b = norm_key(os.path.basename(path))
+    if d in idx and b in idx[d]:
+        return idx[d][b]
+    # fuzzy global (só se único)
+    matches = [rp for dd in idx for k, rp in idx[dd].items() if k == b]
+    if len(matches) == 1:
+        return matches[0]
+    return None
+
+def main(check_only=False):
+    total_fixed = total_dropped = total_ok = 0
+    for rel_json, key, base_rel in TARGETS:
+        jpath = os.path.join(ROOT, rel_json)
+        if not os.path.isfile(jpath):
+            print(f"  (pulado, inexistente) {rel_json}")
+            continue
+        base_abs = os.path.join(ROOT, base_rel)
+        idx, realset = build_disk_index(base_abs)
+        d = json.load(open(jpath, encoding="utf-8"))
+        arr = d.get(key, [])
+        keep, fixed, dropped, ok = [], 0, 0, 0
+        for e in arr:
+            p = e.get("path", "")
+            r = resolve(p, base_abs, idx, realset)
+            if r:
+                if os.path.normpath(r) != os.path.normpath(p):
+                    e["path"] = r; fixed += 1
+                else:
+                    ok += 1
+                keep.append(e)
+            else:
+                dropped += 1
+        if not check_only and (fixed or dropped):
+            d[key] = keep
+            # recalcula contagens simples se existirem
+            if "totalFiles" in d:
+                d["totalFiles"] = len(keep)
+            if "totalItems" in d:
+                d["totalItems"] = len(keep) + d.get("totalLinks", 0)
+            d["updatedAt"] = datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
+            json.dump(d, open(jpath, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
+        flag = "OK" if dropped == 0 else "ATENÇÃO"
+        print(f"  [{flag}] {rel_json}: {len(keep)} válidos · {fixed} corrigidos · {dropped} removidos")
+        total_fixed += fixed; total_dropped += dropped; total_ok += ok
+    print(f"\nResumo: {total_ok} ok · {total_fixed} paths corrigidos · {total_dropped} removidos (404)")
+    if check_only and total_dropped:
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main(check_only="--check" in sys.argv)
