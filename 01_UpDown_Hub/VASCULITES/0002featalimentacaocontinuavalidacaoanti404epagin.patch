+  ['assets/css/content-hub.css', 'content-hub.css'],
+  ['assets/js/content-hub.js', 'content-hub.js'],
+];
+const BIBLIO = [
+  ['02_Biblioteca_IA_Engine/data/biblioteca_documentos_manifest.json', 'Manifesto de documentos', 'files'],
+  ['02_Biblioteca_IA_Engine/data/biblioteca_catalogo.json', 'Catálogo (acervo)', 'items'],
+  ['02_Biblioteca_IA_Engine/data/biblioteca_inbox_manifest_auto.json', 'Manifesto do inbox', 'files'],
+];
+const DATA = [
+  ['05_Midia_E_Feed/data/cards.json', 'Card Feed (cards)', 'cards'],
+  ['04_Ebooks_Intensiva_Clinica/data/catalogo.json', 'Ebooks (catálogo)', 'items'],
+  ['07_Questoes_Comentadas/data/catalogo.json', 'Questões (catálogo)', 'items'],
+  ['08_Transcricoes/data/catalogo.json', 'Transcrições (catálogo)', 'items'],
+  ['09_POCUS_Hub/data/catalogo.json', 'POCUS (catálogo)', 'items'],
+];
+
+let counts = {ok:0, warn:0, err:0};
+function enc(u){return u.split('/').map(encodeURIComponent).join('/');}
+function row(container, name, status, detail){
+  const div = document.createElement('div');
+  div.className = 'row';
+  div.innerHTML = `<span class="badge ${status}">${status==='ok'?'✓ OK':status==='warn'?'⚠ ATEN':status==='err'?'✗ FALHA':'…'}</span>`
+    + `<span class="name">${name}</span><span class="detail">${detail||''}</span>`;
+  container.appendChild(div);
+  if(counts[status]!==undefined) counts[status]++;
+  updateSummary();
+}
+function updateSummary(){
+  document.getElementById('c-ok').textContent = counts.ok;
+  document.getElementById('c-warn').textContent = counts.warn;
+  document.getElementById('c-err').textContent = counts.err;
+  document.getElementById('c-total').textContent = counts.ok+counts.warn+counts.err;
+}
+async function exists(url){
+  try{
+    const r = await fetch(enc(url), {method:'GET', cache:'no-store'});
+    return r.ok;
+  }catch(e){ return false; }
+}
+async function fetchJSON(url){
+  const r = await fetch(enc(url), {cache:'no-store'});
+  if(!r.ok) throw new Error('HTTP '+r.status);
+  return r.json();
+}
+
+async function runAll(){
+  counts = {ok:0, warn:0, err:0};
+  ['g-pages','g-viewer','g-biblio','g-data'].forEach(id=>document.getElementById(id).innerHTML='');
+  updateSummary();
+
+  // Páginas
+  for(const [u,label] of PAGES){
+    const ok = await exists(u);
+    row(document.getElementById('g-pages'), label, ok?'ok':'err', ok?u:('não encontrada: '+u));
+  }
+  // Vendor / viewer
+  for(const [u,label] of VENDOR){
+    const ok = await exists(u);
+    row(document.getElementById('g-viewer'), label, ok?'ok':'err', ok?'carregável':('ausente: '+u));
+  }
+  // Biblioteca: carrega manifesto + valida amostra de paths
+  for(const [u,label,key] of BIBLIO){
+    try{
+      const d = await fetchJSON(u);
+      const arr = d[key] || [];
+      // valida amostra de até 12 paths
+      const sample = arr.filter(x=>x.path).slice(0,12);
+      let bad=0;
+      for(const it of sample){
+        const base = u.substring(0, u.indexOf('/data/')+1);
+        if(!(await exists(base + it.path))) bad++;
+      }
+      const st = arr.length===0 ? 'warn' : (bad>0 ? 'warn' : 'ok');
+      row(document.getElementById('g-biblio'), label, st,
+          `${arr.length} itens · amostra ${sample.length-bad}/${sample.length} paths ok`);
+    }catch(e){
+      row(document.getElementById('g-biblio'), label, 'err', String(e.message||e));
+    }
+  }
+  // Feed + hubs
+  for(const [u,label,key] of DATA){
+    try{
+      const d = await fetchJSON(u);
+      const arr = d[key] || [];
+      row(document.getElementById('g-data'), label, 'ok', `${arr.length} itens`);
+    }catch(e){
+      row(document.getElementById('g-data'), label, 'err', String(e.message||e));
+    }
+  }
+}
+runAll();
+</script>
